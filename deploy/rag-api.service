[Unit]
Description=RAG-AI_Gov FastAPI backend (RAG + CrewAI)
Documentation=https://github.com/kimeastsky2019/brikoai
After=network-online.target docker.service ollama.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@/Rag-extended
# config.py 의 load_dotenv() 가 WorkingDirectory 의 .env 를 읽습니다.

# CrewAI 는 실행 시 홈 디렉터리에 저장소(메모리/텔레메트리 캐시)를 만듭니다.
# 아래 ProtectHome=true 로 /home 이 차단되므로, 쓰기 가능한 APP_DIR 로 돌립니다.
# (ReadWritePaths 에 APP_DIR 이 이미 열려 있습니다)
Environment=HOME=@APP_DIR@
Environment=XDG_DATA_HOME=@APP_DIR@/.local/share
Environment=XDG_CACHE_HOME=@APP_DIR@/.cache
Environment=CREWAI_STORAGE_DIR=@APP_DIR@/.crewai
# --workers 1 고정: 백엔드가 SQLite(aiosqlite) 단일 파일을 쓰고 응답 캐시가
# 프로세스 내 메모리(cachetools)라, 워커를 늘리면 DB 락 경합과 캐시 불일치가 발생합니다.
# 동시 처리량이 필요하면 PostgreSQL + 공유 캐시로 전환 후 늘리세요.
ExecStart=@APP_DIR@/.venv/bin/uvicorn app:app \
    --host 127.0.0.1 \
    --port @API_PORT@ \
    --workers 1 \
    --timeout-keep-alive 75 \
    --proxy-headers \
    --forwarded-allow-ips '*'

Restart=always
RestartSec=5
# 로컬 LLM 추론은 수십 초가 걸릴 수 있으므로 넉넉히
TimeoutStartSec=120
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rag-api

# ── 보안 강화 ──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=@APP_DIR@

[Install]
WantedBy=multi-user.target
