# ──────────────────────────────────────────────
# .env.example — Exo + Qdrant + Ollama 설정
# cp .env.example .env 후 값 수정
# ──────────────────────────────────────────────

# ── LLM: Exo 1.0 클러스터 ──────────────────────
EXO_BASE_URL=http://localhost:52415/v1
EXO_API_KEY=local
LLM_MODEL=qwen2.5:72b

# ── Embedding: Ollama (BGE-M3) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ── Vector DB: Qdrant ──────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=    # 로컬은 빈값

# ── 검색 파라미터 ───────────────────────────────
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── 캐시 ───────────────────────────────────────
CACHE_TTL_SEC=300
CACHE_MAXSIZE=2048

# ── 에이전트 ───────────────────────────────────
AGENT_VERBOSE=false
AGENT_MAX_ITER=5

# ── 비용 추적 (로컬은 0원) ─────────────────────
COST_PER_1M_INPUT=0.0
COST_PER_1M_OUTPUT=0.0

# ── 시스템 프롬프트 (선택 — 기본값 사용 권장) ────
# SYSTEM_GUARDRAIL=당신은 사내 문서 기반 RAG 어시스턴트입니다...

# ──────────────────────────────────────────────
# 하이브리드 폴백 설정 (선택)
# 비어있으면 해당 provider를 스킵합니다.
# ──────────────────────────────────────────────

# [Fallback 1] Grok / xAI — 속도 우선
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# XAI_MODEL=grok-3-mini

# [Fallback 2] ChatGPT / OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# [Fallback 3] Claude / Anthropic — 품질 우선
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Circuit Breaker 파라미터 ────────────────────
# CB_FAILURE_THRESHOLD=3   # 연속 실패 N회 → 차단
# CB_TIMEOUT_SEC=30.0      # 응답 제한 시간 (초)
# CB_RECOVERY_SEC=60       # 차단 후 재시도 대기 (초)
