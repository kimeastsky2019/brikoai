# ──────────────────────────────────────────────
# .env.example — Exo + Qdrant + Ollama 설정
# cp .env.example .env 후 값 수정
# ──────────────────────────────────────────────

# ── LLM: Exo 1.0 클러스터 ──────────────────────
EXO_BASE_URL=http://localhost:52415/v1
EXO_API_KEY=local
LLM_MODEL=qwen2.5:72b

# ── Embedding: Ollama (BGE-M3) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ── Vector DB: Qdrant ──────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=    # 로컬은 빈값

# ── 검색 파라미터 ───────────────────────────────
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── 캐시 ───────────────────────────────────────
CACHE_TTL_SEC=300
CACHE_MAXSIZE=2048

# ── 에이전트 ───────────────────────────────────
AGENT_VERBOSE=false
AGENT_MAX_ITER=5

# ── 비용 추적 (로컬은 0원) ─────────────────────
COST_PER_1M_INPUT=0.0
COST_PER_1M_OUTPUT=0.0

# ── 시스템 프롬프트 (선택 — 기본값 사용 권장) ────
# SYSTEM_GUARDRAIL=당신은 사내 문서 기반 RAG 어시스턴트입니다...
